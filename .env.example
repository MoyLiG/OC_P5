# ===================================================================
# FICHIER DE CONFIGURATION - PROJET OC_P5
# Migration de données médicales vers MongoDB
# ===================================================================
#
# Ce fichier est un TEMPLATE. Copiez-le pour créer vos configurations :
#
#   cp .env.example .env.local         # Pour développement local (étapes 1 et 2)
#   cp .env.example .env.test_docker   # Pour tests Docker (étape 3)
#   cp .env.example .env.docker        # Pour production Docker (étape 4)
#
# ⚠️ IMPORTANT : Les fichiers .env.* sont dans .gitignore et ne doivent
#                JAMAIS être commités sur GitHub (contiennent des secrets)
#
# ===================================================================

# -------------------------------------------------------------------
# CONFIGURATION 1 : .env.local
# Utilisation : Développement local + Tests d'intégration locaux
# Étapes README : 1 (Tests unitaires) et 2 (Tests intégration)
# MongoDB : localhost:27017
# -------------------------------------------------------------------

ENVIRONMENT=local

# MongoDB - Connexion
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=example                    # ⚠️ Mot de passe simple OK pour local uniquement
MONGO_URI=mongodb://root:example@localhost:27017/

# Base de données
DB_NAME=P5_test                                # ← Base de TEST (ne pas écraser la prod)

# Fichier CSV source
CSV_FILE_PATH=./data/healthcare_dataset.csv

# Comptes RBAC MongoDB
# ⚠️ Ces mots de passe DOIVENT correspondre à ceux dans init-mongo.js
MONGO_ADMIN_PASSWORD=SecureAdminPassword123!
MONGO_LECTEUR_PASSWORD=SecureLecteurPassword123!
MONGO_REDACTEUR_PASSWORD=SecureRedacteurPassword123!
MONGO_ADMIN_TEST_PASSWORD=TestAdminPassword123!

# Compte admin pour tests RBAC
MONGO_ADMIN_USER=admin_p5_test


# -------------------------------------------------------------------
# CONFIGURATION 2 : .env.test_docker
# Utilisation : Validation Docker avant push GitHub
# Étape README : 3 (Validation Docker)
# MongoDB : mongodb_test:27017 (port externe 27018)
# -------------------------------------------------------------------

# ENVIRONMENT=test_docker

# # MongoDB - Connexion Docker
# MONGO_ROOT_USER=root
# MONGO_ROOT_PASSWORD=<GÉNÉRER_MOT_DE_PASSE_FORT>    # Utiliser la commande ci-dessous
# MONGO_URI=mongodb://root:<MONGO_ROOT_PASSWORD>@mongodb_test:27017/

# # Base de données
# DB_NAME=P5_test

# # Fichier CSV source (chemin Docker)
# CSV_FILE_PATH=/app/data/healthcare_dataset.csv

# # Comptes RBAC MongoDB
# MONGO_ADMIN_PASSWORD=<GÉNÉRER_MOT_DE_PASSE_FORT>
# MONGO_LECTEUR_PASSWORD=<GÉNÉRER_MOT_DE_PASSE_FORT>
# MONGO_REDACTEUR_PASSWORD=<GÉNÉRER_MOT_DE_PASSE_FORT>
# MONGO_ADMIN_TEST_PASSWORD=<GÉNÉRER_MOT_DE_PASSE_FORT>

# # Compte admin pour tests RBAC
# MONGO_ADMIN_USER=admin_p5_test


# -------------------------------------------------------------------
# CONFIGURATION 3 : .env.docker
# Utilisation : Déploiement production
# Étape README : 4 (Production Docker)
# MongoDB : mongodb:27017
# -------------------------------------------------------------------

# ENVIRONMENT=docker

# # MongoDB - Connexion Docker
# MONGO_ROOT_USER=root
# MONGO_ROOT_PASSWORD=<GÉNÉRER_MOT_DE_PASSE_TRÈS_FORT>  # ⚠️ PRODUCTION : 20+ caractères
# MONGO_URI=mongodb://root:<MONGO_ROOT_PASSWORD>@mongodb:27017/

# # Base de données
# DB_NAME=P5                                    # ← Base de PRODUCTION

# # Fichier CSV source (chemin Docker)
# CSV_FILE_PATH=/data/healthcare_dataset.csv

# # Comptes RBAC MongoDB
# MONGO_ADMIN_PASSWORD=<GÉNÉRER_MOT_DE_PASSE_TRÈS_FORT>
# MONGO_LECTEUR_PASSWORD=<GÉNÉRER_MOT_DE_PASSE_TRÈS_FORT>
# MONGO_REDACTEUR_PASSWORD=<GÉNÉRER_MOT_DE_PASSE_TRÈS_FORT>
# MONGO_ADMIN_TEST_PASSWORD=<GÉNÉRER_MOT_DE_PASSE_TRÈS_FORT>

# # Compte admin pour production
# MONGO_ADMIN_USER=admin_p5


# ===================================================================
# GÉNÉRATION DE MOTS DE PASSE FORTS
# ===================================================================
#
# Pour générer un mot de passe fort de 20 caractères :
#
#   python -c "import secrets, string; print(''.join(secrets.choice(string.ascii_letters + string.digits + '!@#$%^&*') for _ in range(20)))"
#
# Exemple de sortie : aB3!xZ9@mK2$pQ7&nR5%
#
# ⚠️ IMPORTANT :
# - Utilisez des mots de passe DIFFÉRENTS pour chaque environnement
# - Ne JAMAIS réutiliser les mots de passe de test en production
# - Stockez les mots de passe de production dans un gestionnaire sécurisé
#
# ===================================================================


# ===================================================================
# VARIABLES POUR init-mongo.js
# ===================================================================
#
# Le script init-mongo.js utilise les variables d'environnement pour
# créer les comptes RBAC MongoDB :
#
# - MONGO_ADMIN_PASSWORD      → Compte admin_p5 (production)
# - MONGO_LECTEUR_PASSWORD    → Compte lecteur_p5 (lecture seule)
# - MONGO_REDACTEUR_PASSWORD  → Compte redacteur_p5 (lecture/écriture)
# - MONGO_ADMIN_TEST_PASSWORD → Compte admin_p5_test (tests)
#
# Ces mots de passe sont injectés dans init-mongo.js via Docker Compose
# (voir docker-compose.yml section environment)
#
# ===================================================================


# ===================================================================
# STRUCTURE DES FICHIERS .env
# ===================================================================
#
# Fichiers .env dans le projet :
#
# .env.example        ← Ce fichier (template, commité sur Git)
# .env.local          ← Dev local + Tests intégration (à créer, .gitignore)
# .env.test_docker    ← Tests Docker (à créer, .gitignore)
# .env.docker         ← Production Docker (à créer, .gitignore)
#
# Tous les .env.* (sauf .env.example) sont dans .gitignore pour
# protéger les secrets.
#
# ===================================================================


# ===================================================================
# GITHUB SECRETS (pour CI/CD)
# ===================================================================
#
# Pour GitHub Actions, configurez ces secrets dans :
# GitHub → Settings → Secrets and variables → Actions
#
# Secrets requis :
# - MONGO_ROOT_PASSWORD
# - MONGO_ADMIN_PASSWORD
# - MONGO_LECTEUR_PASSWORD
# - MONGO_REDACTEUR_PASSWORD
# - MONGO_ADMIN_TEST_PASSWORD
#
# Ces secrets sont utilisés dans .github/workflows/run_tests.yml
#
# ===================================================================


# ===================================================================
# AIDE ET DOCUMENTATION
# ===================================================================
#
# Pour plus d'informations, consultez le README.md section :
# "Installation et configuration"
#
# Questions fréquentes :
#
# Q: Pourquoi 3 fichiers .env différents ?
# A: Pour séparer les environnements (local, test Docker, production)
#    et éviter de mélanger les configurations.
#
# Q: Puis-je utiliser le même mot de passe partout ?
# A: NON ! Utilisez des mots de passe différents, surtout pour
#    la production. C'est une bonne pratique de sécurité.
#
# Q: Que faire si j'ai oublié mon mot de passe de production ?
# A: Recréez le conteneur Docker avec un nouveau mot de passe.
#    Attention : cela supprimera les données si vous ne sauvegardez
#    pas le volume MongoDB d'abord.
#
# Q: .env.local utilise P5_test, pas P5. Pourquoi ?
# A: Pour éviter d'écraser accidentellement vos données de production
#    si vous avez MongoDB qui tourne localement avec une vraie base P5.
#
# ===================================================================


# ===================================================================
# CHECKLIST DE SÉCURITÉ
# ===================================================================
#
# Avant de déployer en production :
#
# ✓ Les fichiers .env.* sont bien dans .gitignore
# ✓ Les mots de passe de production sont forts (20+ caractères)
# ✓ Les mots de passe sont DIFFÉRENTS entre test et production
# ✓ Les GitHub Secrets sont configurés
# ✓ Les mots de passe sont stockés dans un gestionnaire sécurisé
# ✓ Le fichier .env.docker n'est JAMAIS commité
#
# ===================================================================
