# Environnement (local | test | docker | test_docker)
ENVIRONMENT=local

# MongoDB - Compte root
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=

# MongoDB - Mots de passe des utilisateurs RBAC (utilisés par init-mongo.js)
MONGO_ADMIN_PASSWORD=
MONGO_LECTEUR_PASSWORD=
MONGO_REDACTEUR_PASSWORD=
MONGO_ADMIN_TEST_PASSWORD=

# MongoDB - Connexion
MONGO_URI=mongodb://localhost:27017/

# Base de données
DB_NAME=P5

# Chemin CSV
CSV_FILE_PATH=./data/healthcare_dataset.csv

# Variables pour les différents comptes MongoDB
MONGO_ADMIN_USER=admin_p5
MONGO_LECTEUR_USER=lecteur_p5
MONGO_REDACTEUR_USER=redacteur_p5

# Clé de chiffrement (pour JWT, sessions, etc.)
SECRET_KEY=
